---
import { skills } from '../data/profile';
import SectionHeading from './SectionHeading.astro';
---

<section id="skills" class="reveal mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <SectionHeading index="04" command="cat skills.json" title="Skills & tools" />
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((s) => (
        <div class="card p-5">
          <h3 class="font-mono text-sm">
            <span class="text-violet">"{s.group}"</span>
            <span class="text-muted">: [</span>
          </h3>
          <ul class="mt-3 flex flex-wrap gap-2 pl-3">
            {s.items.map((item) => (
              <li class="rounded-md border border-line bg-surface-2 px-2.5 py-1 text-sm">{item}</li>
            ))}
          </ul>
          <p class="mt-2 font-mono text-sm text-muted">]</p>
        </div>
      ))
    }
  </div>
</section>
