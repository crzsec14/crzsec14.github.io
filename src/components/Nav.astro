---
import { profile } from '../data/profile';

const items = [
  { href: '#about', label: 'about' },
  { href: '#experience', label: 'experience' },
  { href: '#work', label: 'work' },
  { href: '#skills', label: 'skills' },
  { href: '#contact', label: 'contact' },
];
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-bg/70 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6" aria-label="Main">
    <a href="#top" class="font-mono text-sm">
      <span class="text-green">~</span><span class="text-muted">/</span>{profile.handle}
    </a>
    <ul class="hidden items-center gap-6 font-mono text-sm text-muted md:flex">
      {
        items.map((i) => (
          <li>
            <a href={i.href} class="transition-colors hover:text-ink">
              <span class="text-violet">▸</span>
              {i.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={`mailto:${profile.email}`}
      class="rounded-lg border border-line px-3 py-1.5 font-mono text-xs text-ink transition-colors hover:border-violet hover:text-violet"
    >
      say hi
    </a>
  </nav>
</header>
