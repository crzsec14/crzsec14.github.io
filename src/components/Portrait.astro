---
import { profile } from '../data/profile';

// Badges that orbit the photo; `a` is each one's starting angle.
const orbit = [
  { label: 'C#', a: 0 },
  { label: '.NET', a: 60 },
  { label: 'React', a: 120 },
  { label: 'Azure', a: 180 },
  { label: 'Angular', a: 240 },
  { label: 'Flutter', a: 300 },
];
---

<div class="portrait relative mx-auto aspect-square w-64 sm:w-80">
  <!-- HUD corner brackets -->
  <span class="hud-corner top-0 left-0 border-t-2 border-l-2" aria-hidden="true"></span>
  <span class="hud-corner top-0 right-0 border-t-2 border-r-2" aria-hidden="true"></span>
  <span class="hud-corner bottom-0 left-0 border-b-2 border-l-2" aria-hidden="true"></span>
  <span class="hud-corner right-0 bottom-0 border-r-2 border-b-2" aria-hidden="true"></span>

  <p class="absolute -top-6 left-0 font-mono text-[10px] tracking-widest text-cyan/80" aria-hidden="true">ID://CESS.CRUZ</p>
  <p class="absolute right-0 -bottom-6 font-mono text-[10px] tracking-widest text-violet/80" aria-hidden="true">SYS.STATUS: ONLINE</p>

  <!-- Glow, spinning gradient ring and dashed counter-ring -->
  <div class="absolute inset-6 rounded-full bg-gradient-to-br from-violet to-cyan opacity-40 blur-2xl" aria-hidden="true"></div>
  <div class="ring-spin absolute inset-6 rounded-full" aria-hidden="true"></div>
  <div class="ring-dash absolute inset-2 rounded-full border border-dashed border-cyan/30" aria-hidden="true"></div>

  <!-- Photo with boot-up reveal and scan line -->
  <div class="photo absolute inset-[30px] overflow-hidden rounded-full bg-surface">
    <img
      src={profile.avatar}
      alt={`Portrait of ${profile.displayName}`}
      width="800"
      height="800"
      class="h-full w-full object-cover object-[50%_30%]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-violet/25 via-transparent to-cyan/10 mix-blend-overlay" aria-hidden="true"></div>
    <div class="scanline" aria-hidden="true"></div>
  </div>

  <!-- Orbiting tech badges (hidden on small screens to avoid overflow) -->
  <div class="orbit absolute inset-0 hidden sm:block" aria-hidden="true">
    {
      orbit.map((o) => (
        <span class="orbit-item" style={`--a:${o.a}deg`}>
          <span class="orbit-label">{o.label}</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .hud-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border-color: var(--color-cyan);
    opacity: 0.7;
  }

  .ring-spin {
    padding: 2px;
    background: conic-gradient(from 0deg, var(--color-violet), var(--color-cyan), transparent 45%, var(--color-violet));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: spin 6s linear infinite;
  }
  .ring-dash {
    animation: spin 40s linear infinite reverse;
  }

  .photo {
    box-shadow: 0 0 0 1px var(--color-line), 0 20px 60px -20px rgb(124 58 237 / 0.6);
    animation: boot 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes boot {
    0% { clip-path: circle(0% at 50% 50%); filter: blur(12px) saturate(0) brightness(1.6); }
    60% { filter: blur(2px) saturate(0.4) brightness(1.2); }
    100% { clip-path: circle(75% at 50% 50%); filter: none; }
  }

  .scanline {
    position: absolute;
    inset-inline: 0;
    height: 30%;
    top: -30%;
    background: linear-gradient(to bottom, transparent, rgb(34 211 238 / 0.18) 70%, rgb(34 211 238 / 0.55) 98%, transparent);
    animation: scan 4.5s ease-in-out 1.2s infinite;
  }
  @keyframes scan {
    0% { top: -30%; }
    55%, 100% { top: 110%; }
  }

  .orbit {
    --r: 172px;
    animation: spin 36s linear infinite;
  }
  .orbit-item {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: rotate(var(--a)) translateX(var(--r)) rotate(calc(-1 * var(--a)));
  }
  .orbit-label {
    display: inline-block;
    transform: translate(-50%, -50%);
    border: 1px solid var(--color-line);
    background: rgb(15 15 24 / 0.85);
    backdrop-filter: blur(6px);
    border-radius: 9999px;
    padding: 2px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink);
    white-space: nowrap;
    /* Counter-spin so labels stay upright while the orbit turns */
    animation: spin-upright 36s linear infinite reverse;
  }
  @keyframes spin-upright {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring-spin, .ring-dash, .orbit, .orbit-label, .scanline, .photo {
      animation: none;
    }
    .scanline { display: none; }
  }
</style>
